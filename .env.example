# Accounts are private and administrator-configured. Use unique 12+ character passwords.
APP_USERS={"kishor":"replace-with-a-strong-password","friend":"replace-with-another-strong-password"}
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local HTTP only. Production HTTPS must use true.
COOKIE_SECURE=false
MEDIA_PROVIDER=vyla
# Self-hosted Vyla service; Docker Compose sets its internal URL automatically.
VYLA_BASE_URL=http://127.0.0.1:7860
# TMDB API key (v3 API key, not the long v4 bearer token); never commit it.
TMDB_API_KEY=
# Required on Heroku for durable watchlists/progress. Never store its credentials in Git.
# DATABASE_URL=postgresql://...
